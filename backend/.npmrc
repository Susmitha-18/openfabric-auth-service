# better-sqlite3@13 bundles prebuilt N-API binaries for all major platforms.
# npm 11 (Node 24) incorrectly triggers node-gyp when it finds binding.gyp
# in the package, even though the package sets "gypfile": false.
# This flag prevents that source-compilation fallback.
# The prebuilt binary at node_modules/better-sqlite3/prebuilds/win32-x64.node
# is loaded at runtime automatically.
ignore-scripts=true
