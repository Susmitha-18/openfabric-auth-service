# OpenFabric Authorization Service - Backend Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to version control.

# AWS Region where your Cognito User Pool is hosted.
# Example: us-east-1
AWS_REGION=your-aws-region

# Your Amazon Cognito User Pool ID.
# Example: us-east-1_AbCdEfGhI
COGNITO_USER_POOL_ID=your-user-pool-id

# Your Amazon Cognito App Client ID (the client configured for this service).
# Example: 1abc2defghijk3lmnopqrstu4v
COGNITO_CLIENT_ID=your-app-client-id

# Optional: Cognito Admin Group
COGNITO_ADMIN_GROUP=admin

# TCP port the server listens on. Defaults to 5000 if not set.
# PORT=5000
